---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProductCard from "@/components/ProductCard.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Query produk collection
const produkCollection = await getCollection("produk");
const allProduk = produkCollection
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

const title = "Katalog Produk";
const description = "Semua script siap pakai untuk otomasi bisnis dan development.";
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content" class="app-layout">
    <!-- Hero Section -->
    <section class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 text-4xl leading-tight font-bold sm:my-8 sm:text-5xl">
        {title}
      </h1>
      <p class="text-muted-foreground text-lg">
        {description}
      </p>
    </section>

    <!-- All Products -->
    <section class="pt-12 pb-6">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-semibold tracking-wide">
          {allProduk.length} Produk Tersedia
        </h2>
      </div>
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {allProduk.map(produk => <ProductCard slug={produk.id} data={produk.data} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
---