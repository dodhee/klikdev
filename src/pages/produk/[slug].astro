---
import { getCollection, type CollectionEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BailoutCTA from "@/components/BailoutCTA.astro";
import ProductSchema from "@/components/ProductSchema.astro";
import BreadcrumbListSchema from "@/components/BreadcrumbListSchema.astro";
import FAQPageSchema from "@/components/FAQPageSchema.astro";
import AggregateRatingSchema from "@/components/AggregateRatingSchema.astro";
import ReviewSchema from "@/components/ReviewSchema.astro";
import HowToSchema from "@/components/HowToSchema.astro";
import TestimonialList from "@/components/TestimonialList.astro";
import RelatedProducts from "@/components/RelatedProducts.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { getTestimonialsByProduct } from "@/data/testimonials";
import { calculateAggregateRating } from "@/data/testimonials/schema";

export async function getStaticPaths() {
  const produkCollection = await getCollection("produk");
  return produkCollection
    .filter(({ data }) => !data.draft)
    .map(produk => ({
      params: { slug: produk.id },
      props: { produk },
    }));
}

type Props = {
  produk: CollectionEntry<"produk">;
};

const { produk } = Astro.props;
const { data } = produk;
const { Content } = await render(produk);

const locale = Astro.currentLocale ?? config.site.lang;

// Load testimonials untuk produk ini
const testimonials = getTestimonialsByProduct(produk.id);
const aggregateRating = calculateAggregateRating(testimonials);

// Load all products untuk related products
const allProducts = await getCollection("produk");

// Breadcrumb data
const breadcrumbs = [
  { label: "Home", url: getRelativeLocaleUrl(locale, "") },
  { label: "Produk", url: getRelativeLocaleUrl(locale, "katalog") },
  { label: produk.data.title, url: "" },
];

// Tab sections
const tabs = [
  { id: "masalah-solusi", label: "Masalah dan Solusi" },
  { id: "cara-kerja", label: "Cara Kerja" },
  { id: "tech-stack", label: "Tech Stack" },
  { id: "panduan-deploy", label: "Panduan Deploy" },
  { id: "faq", label: "FAQ" },
];

// FAQ data untuk schema
const faqs = [
  {
    question: "Apakah bisa diintegrasikan dengan database eksternal?",
    answer: "Ya, tapi perlu custom. Script ini by default hanya berinteraksi dengan Google Sheets. Jika butuh integrasi ke MySQL/PostgreSQL/Firebase, itu masuk kategori DFY (Done-For-You)."
  },
  {
    question: "Berapa batas data yang bisa dihandle?",
    answer: "Google Apps Script punya quota 6 menit execution time per trigger. Untuk data >10,000 rows, saya sarankan pakai batch processing (tidak include di script ini, perlu custom)."
  },
  {
    question: "Apakah mendukung multi-user collaboration?",
    answer: "Ya, script ini aman untuk multi-user. Setiap action tercatat dengan email user yang melakukan perubahan."
  },
  {
    question: "Bagaimana cara update script jika ada bug?",
    answer: "Pull update dari repo, lalu clasp push lagi. Trigger tidak perlu di-setup ulang."
  },
  {
    question: "Apakah ada dokumentasi API?",
    answer: "Ya, semua fungsi publik ada JSDoc-nya. Buka di Apps Script Editor untuk lihat intellisense."
  }
];

// HowTo steps untuk deploy (generic steps)
const deploySteps = [
  {
    name: "Install Google Clasp CLI",
    text: "Install @google/clasp secara global menggunakan npm. Pastikan Node.js sudah terinstal di sistem Anda."
  },
  {
    name: "Login ke Google Account",
    text: "Jalankan 'clasp login' di terminal untuk autentikasi dengan Google Account yang akan digunakan untuk deployment."
  },
  {
    name: "Clone atau Download Script",
    text: "Download source code dari repository dan extract ke folder lokal Anda."
  },
  {
    name: "Setup Clasp Project",
    text: "Buat file .clasp.json dengan scriptId dari Apps Script project Anda. Atau gunakan 'clasp create' untuk project baru."
  },
  {
    name: "Push Script ke Apps Script",
    text: "Jalankan 'clasp push' untuk upload semua file ke Google Apps Script project Anda."
  },
  {
    name: "Setup Trigger dan Permissions",
    text: "Buka Apps Script Editor, setup trigger sesuai kebutuhan, dan authorize permissions yang diperlukan."
  }
];
---

<Layout
  title={data.title}
  description={data.description}
  ogImage={typeof data.thumbnail === "string" ? data.thumbnail : undefined}
  ogType="product"
  productPrice={data.harga}
  productCurrency="IDR"
>
  <Fragment slot="head">
    <ProductSchema
      name={data.title}
      description={data.description}
      image={typeof data.thumbnail === "string" ? data.thumbnail : data.thumbnail.src}
      price={data.harga}
      currency="IDR"
      url={Astro.url.href}
      brand="KlikDev"
      category={data.kategori}
    />
    
    <BreadcrumbListSchema items={breadcrumbs} />
    
    <FAQPageSchema faqs={faqs} />

    {/* AggregateRating Schema - hanya tampil jika ada review */}
    {aggregateRating && (
      <AggregateRatingSchema
        itemName={data.title}
        itemUrl={Astro.url.href}
        ratingValue={aggregateRating.averageRating}
        ratingCount={aggregateRating.ratingCount}
      />
    )}

    {/* Individual Review Schema - tampil jika ada testimonials */}
    {testimonials.length > 0 && (
      <ReviewSchema
        reviews={testimonials}
        itemName={data.title}
        itemUrl={Astro.url.href}
      />
    )}

    {/* HowTo Schema - panduan deploy */}
    <HowToSchema
      name={`Cara Deploy ${data.title}`}
      description={`Panduan langkah demi langkah untuk deploy ${data.title} menggunakan Google Clasp CLI`}
      totalTime="PT15M"
      steps={deploySteps}
    />
  </Fragment>

  <Header />
  <main>
  <div class="app-layout py-8">
    <!-- Hero Section -->
    <section class="border-border border-b pb-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm">
        {
          breadcrumbs.map((crumb, index) => (
            <li class="flex items-center gap-2">
              {index > 0 && (
                <span class="text-muted-foreground" aria-hidden="true">
                  /
                </span>
              )}
              {crumb.url ? (
                <a
                  href={crumb.url}
                  class="text-muted-foreground hover:text-mbah-accent transition-colors"
                >
                  {crumb.label}
                </a>
              ) : (
                <span class="text-foreground font-medium">{crumb.label}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <!-- Title & Badge -->
    <div class="mb-4">
      <span
        class="bg-mbah-accent/10 text-mbah-accent mb-3 inline-block rounded-full px-3 py-1 text-sm font-medium"
      >
        {data.kategori}
      </span>
      <h1 class="text-foreground text-4xl leading-tight font-bold sm:text-5xl">
        {data.title}
      </h1>
    </div>

    <!-- Description -->
    <p class="text-muted-foreground mb-6 text-lg">{data.description}</p>

    <!-- Specs Grid -->
    <div class="bg-card border-border mb-6 grid gap-4 rounded-lg border p-6 sm:grid-cols-3">
      <!-- Stack -->
      <div>
        <p class="text-muted-foreground mb-2 text-sm">Tech Stack</p>
        <div class="flex flex-wrap gap-1">
          {
            data.stack.slice(0, 3).map(tech => (
              <span class="bg-muted font-signature text-foreground rounded px-2 py-1 text-xs">
                {tech}
              </span>
            ))
          }
          {
            data.stack.length > 3 && (
              <span class="bg-muted font-signature text-muted-foreground rounded px-2 py-1 text-xs">
                +{data.stack.length - 3}
              </span>
            )
          }
        </div>
      </div>

      <!-- Deploy Time -->
      <div>
        <p class="text-muted-foreground mb-2 text-sm">Waktu Deploy</p>
        <p class="font-signature text-foreground text-lg font-semibold">
          {data.waktuDeploy}
        </p>
      </div>

      <!-- Price -->
      <div>
        <p class="text-muted-foreground mb-2 text-sm">Harga</p>
        <p class="text-mbah-accent whitespace-nowrap text-2xl font-bold">
          {
            new Intl.NumberFormat("id-ID", {
              style: "currency",
              currency: "IDR",
              minimumFractionDigits: 0,
            })
              .format(data.harga)
              .replace("Rp", "Rp ")
          }
        </p>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="mb-6 flex flex-wrap gap-4">
      <a
        href={data.linkBeli}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-mbah-accent hover:bg-mbah-accent-hover inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold text-white transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m3 21 1.65-3.8a9 9 0 1 1 3.4 2.9z"></path>
          <path
            d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"
          ></path>
        </svg>
        Beli via WhatsApp
      </a>
      <BailoutCTA slug={produk.id} linkDfy={data.linkDfy} />
    </div>
  </section>

  <!-- Tab Navigation -->
  <section class="border-border sticky top-0 z-10 border-b bg-background/80 backdrop-blur-sm">
    <nav class="app-layout overflow-x-auto">
      <ul class="flex gap-1 py-2">
        {
          tabs.map((tab, index) => (
            <li>
              <a
                href={`#${tab.id}`}
                data-tab={tab.id}
                class:list={[
                  "text-foreground hover:text-mbah-accent block whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition-colors",
                  { "bg-mbah-accent/10 text-mbah-accent": index === 0 },
                ]}
              >
                {tab.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <!-- MDX Content -->
  <article class="prose prose-lg dark:prose-invert max-w-none py-8">
    <Content />
  </article>

  <!-- Testimonials Section -->
  <TestimonialList 
    testimonials={testimonials}
    productSlug={produk.id}
    productTitle={data.title}
    whatsappNumber="6281234796567"
  />

  <!-- Related Products Section -->
  <RelatedProducts
    currentProductId={produk.id}
    currentCategory={data.kategori}
    currentStack={data.stack}
    allProducts={allProducts}
    maxProducts={3}
  />

  <!-- Bail-out Alert Box (Footer) -->
  <section class="border-border border-t pt-8">
    <div class="bg-mbah-accent rounded-lg border-l-4 border-mbah-accent-hover p-6">
      <h3 class="text-white mb-2 text-xl font-semibold">
        Butuh yang Skala Enterprise?
      </h3>
      <p class="text-white mb-4">
        Script ini murni untuk DIY. Jika butuh di-custom penuh, saya (Dody/mbah)
        mengerjakannya secara Done-For-You.
      </p>
      <a
        href={data.linkDfy}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-white hover:bg-gray-100 text-mbah-accent inline-flex items-center gap-2 rounded-lg px-6 py-3 font-semibold transition-colors"
      >
        Lihat Layanan DFY Saya →
      </a>
    </div>
  </section>
  </div>
  </main>
  <Footer />
</Layout>

<script>
  // Tab navigation with scroll spy
  function initTabNavigation() {
    const tabs = document.querySelectorAll("[data-tab]");
    const sections = Array.from(tabs).map(tab =>
      document.getElementById(tab.getAttribute("data-tab") || "")
    );

    // Update active tab on scroll
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tabs.forEach(tab => {
              const isActive = tab.getAttribute("data-tab") === id;
              tab.classList.toggle("bg-mbah-accent/10", isActive);
              tab.classList.toggle("text-mbah-accent", isActive);
            });
          }
        });
      },
      { threshold: 0.5, rootMargin: "-100px 0px -50% 0px" }
    );

    sections.forEach(section => {
      if (section) observer.observe(section);
    });

    // Smooth scroll on tab click
    tabs.forEach(tab => {
      tab.addEventListener("click", e => {
        e.preventDefault();
        const targetId = tab.getAttribute("data-tab");
        const target = document.getElementById(targetId || "");
        if (target) {
          const offset = 100; // Account for sticky header
          const top = target.offsetTop - offset;
          window.scrollTo({ top, behavior: "smooth" });
        }
      });
    });
  }

  initTabNavigation();
  document.addEventListener("astro:after-swap", initTabNavigation);
</script>
