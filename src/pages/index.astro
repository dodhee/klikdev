---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ProductCard from "@/components/ProductCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import StickyBanner from "@/components/StickyBanner.astro";
import { useTranslations } from "@/i18n";
import { getAllVerifiedTestimonials } from "@/data/testimonials";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Query produk collection - hanya featured untuk homepage
const produkCollection = await getCollection("produk");
const featuredProduk = produkCollection
  .filter(({ data }) => !data.draft && data.featured)
  .sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());

// Query all verified testimonials
const testimonials = getAllVerifiedTestimonials();

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <StickyBanner />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <!-- Hero Section -->
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 text-2xl leading-tight font-bold sm:my-8 sm:text-4xl">
        Berhenti Menulis Ulang Boilerplate Google Apps Script.
      </h1>

      <div class="prose prose-lg max-w-none">
        <p class="text-muted-foreground">
          Saya Dody, tapi teman-teman panggil saya <strong
            class="text-foreground">mbah</strong
          >. Saya sudah menghabiskan ribuan jam mengotomasi Google Workspace dan
          mengintegrasikan Gemini AI. Di sini, saya menjual sistem otomasi siap
          pakai yang sudah saya uji di produksi. Bukan sekadar kode mentah, tapi
          arsitektur yang bekerja.
        </p>
      </div>

      <div class="mt-6 flex flex-wrap gap-4">
        <LinkButton
          href={getRelativeLocaleUrl(locale, "katalog")}
          class="bg-mbah-accent hover:bg-mbah-accent-hover text-white hover:text-white px-6 py-3 rounded-lg"
        >
          Lihat Katalog Sistem
        </LinkButton>
        <LinkButton
          href={getRelativeLocaleUrl(locale, "posts")}
          class="border-border hover:border-foreground border px-6 py-3 rounded-lg"
        >
          Baca Panduan Gratis
        </LinkButton>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <!-- DFY Callout -->
    <section class="border-border border-b pt-8 pb-6">
      <div class="bg-mbah-accent rounded-lg border-l-4 border-mbah-accent-hover p-6">
        <p class="text-white leading-relaxed">
          <strong class="text-white font-semibold"
            >Tidak punya waktu untuk deploy sendiri?</strong
          >
          Cek layanan Done-For-You saya di
          <a
            href="https://godev.biz.id?utm_source=klikdev&utm_medium=homepage&utm_campaign=dfy_callout"
            target="_blank"
            rel="noopener noreferrer"
            data-track-bailout="true"
            data-utm-medium="homepage"
            data-utm-campaign="dfy_callout"
            class="text-white hover:text-gray-100 font-semibold underline decoration-dashed underline-offset-4"
          >
            godev →
          </a>
        </p>
      </div>
    </section>

    <!-- Featured Products -->
    {
      featuredProduk.length > 0 && (
        <section id="featured" class="pt-12 pb-6">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="text-2xl font-semibold tracking-wide">
              Produk Unggulan
            </h2>
            <LinkButton
              href={getRelativeLocaleUrl(locale, "katalog")}
              class="text-mbah-accent hover:text-mbah-accent-hover"
            >
              Lihat Semua Produk
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {featuredProduk.map(produk => (
              <ProductCard slug={produk.id} data={produk.data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Testimonials Carousel -->
    <TestimonialCarousel testimonials={testimonials} />

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        Baca Tutorial & Panduan
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
