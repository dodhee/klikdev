---
/**
 * ProductLayout - Layout untuk halaman detail produk
 * Adaptasi dari PostLayout.astro dengan tambahan field spesifik produk
 */

import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  breadcrumbs?: Array<{ label: string; url: string }>;
};

const {
  title,
  description,
  ogImage,
  canonicalURL,
} = Astro.props;
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <slot />
</Layout>
</content>