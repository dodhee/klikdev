---
/**
 * TimeCalculator.astro
 * Komponen untuk menampilkan estimasi waktu setup dan skill yang dibutuhkan
 * 
 * Props:
 * - estimasiSetup: string (contoh: "2-4 jam")
 * - skillDibutuhkan: string[] (contoh: ["Git", "Apps Script API"])
 * - slug: string (untuk UTM campaign)
 */

import { generateGodevHargaUrl } from "@/utils/UTMHelper";

interface Props {
  estimasiSetup: string;
  skillDibutuhkan: string[];
  slug: string;
}

const { estimasiSetup, skillDibutuhkan, slug } = Astro.props;

// Defensive check: skip render jika data tidak lengkap
const hasValidData = estimasiSetup && skillDibutuhkan && Array.isArray(skillDibutuhkan) && skillDibutuhkan.length > 0;

// Generate URL godev halaman harga dengan UTM (hanya jika data valid)
const godevUrl = hasValidData ? generateGodevHargaUrl("calculator", slug) : "";
---

{hasValidData && (
<div
  class="my-6 border-l-4 border-mbah-accent bg-gray-50 dark:bg-gray-800/50 p-6 rounded-r-lg"
  role="complementary"
  aria-label="Informasi waktu setup dan skill"
>
  <div class="space-y-4">
    <!-- Estimasi Waktu Setup -->
    <div class="flex items-start gap-3">
      <span class="text-2xl" aria-hidden="true">⏱️</span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1">
          Estimasi Waktu Setup
        </p>
        <p class="text-base font-medium text-gray-900 dark:text-gray-100">
          {estimasiSetup}
        </p>
      </div>
    </div>

    <!-- Skill yang Dibutuhkan -->
    <div class="flex items-start gap-3">
      <span class="text-2xl" aria-hidden="true">🛠️</span>
      <div class="flex-1">
        <p class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
          Skill yang Dibutuhkan
        </p>
        <div class="flex flex-wrap gap-2">
          {
            skillDibutuhkan.map(skill => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200">
                {skill}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- CTA DFY -->
    <div class="flex items-start gap-3 pt-2 border-t border-gray-200 dark:border-gray-700">
      <span class="text-2xl" aria-hidden="true">💡</span>
      <div class="flex-1">
        <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">
          Belum siap dengan setup manual? Saya bisa kerjakan untuk Anda dalam
          30 menit.
        </p>
        <a
          href={godevUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track-bailout="true"
          data-utm-medium="calculator"
          data-utm-campaign={slug}
          class="inline-flex items-center gap-2 px-4 py-2 bg-mbah-accent hover:bg-mbah-accent-hover text-white rounded-md text-sm font-medium transition-colors duration-200"
          aria-label="Ke layanan Done-For-You di godev"
        >
          <span>Saya Kerjakan (DFY)</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Ensure proper spacing and visual hierarchy */
  @media (max-width: 640px) {
    .space-y-4 {
      gap: 0.75rem;
    }
  }
</style>
)}