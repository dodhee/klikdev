---
/**
 * BailoutCTA - Tombol CTA untuk redirect ke layanan DFY di godev
 * Menggunakan UTMHelper untuk konsistensi tracking
 */

import { generateGodevHargaUrl } from "@/utils/UTMHelper";

interface Props {
  slug: string;
  linkDfy?: string;
  variant?: "default" | "box";
}

const { slug, linkDfy, variant = "default" } = Astro.props;

// ALWAYS generate URL ke halaman harga godev (ignore linkDfy dari frontmatter)
const finalUrl = generateGodevHargaUrl("bailout", slug);
---

{
  variant === "box" ? (
    <aside class="border-border bg-muted my-8 rounded-lg border-l-4 border-l-mbah-accent p-6">
      <h3 class="text-lg font-semibold mb-2">Butuh yang Skala Enterprise?</h3>
      <p class="text-muted-foreground mb-4">
        Script ini murni untuk DIY. Jika butuh di-custom penuh atau integrasi
        dengan sistem existing, saya (Dody/mbah) mengerjakannya secara
        Done-For-You.
      </p>
      <a
        href={finalUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-bailout="true"
        data-utm-medium="bailout"
        data-utm-campaign={slug}
        class="hover:bg-mbah-accent-hover inline-flex items-center rounded-md border-2 border-mbah-accent px-4 py-2 font-medium text-mbah-accent transition-colors hover:text-white"
      >
        Lihat Layanan DFY Saya →
      </a>
    </aside>
  ) : (
    <a
      href={finalUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-track-bailout="true"
      data-utm-medium="bailout"
      data-utm-campaign={slug}
      class="hover:bg-mbah-accent-hover inline-flex items-center rounded-md border-2 border-mbah-accent px-4 py-2 font-medium text-mbah-accent transition-colors hover:text-white"
    >
      Pusing Setup-nya? Saya yang Kerjakan (DFY) →
    </a>
  )
}

<script is:inline>
  (function() {
    var bailoutLinks = document.querySelectorAll('[data-utm-medium="bailout"]');
    bailoutLinks.forEach(function(link) {
      if (link.dataset.trackingAttached === "true") return;
      link.dataset.trackingAttached = "true";
      link.addEventListener("click", function(e) {
        var t = e.currentTarget;
        var md = t.dataset.utmMedium || "bailout";
        var cp = t.dataset.utmCampaign || "unknown";
        var ev = { event_category: "bailout", event_label: md + "_" + cp, utm_medium: md, utm_campaign: cp, outbound_url: "godev.biz.id", value: 1 };
        if (window.gtag) { window.gtag("event", "click_bailout", ev); }
        else if (window.dataLayer) { window.dataLayer.push(["event", "click_bailout", ev]); }
        console.log("[KlikDev] BailoutCTA tracked:", { medium: md, campaign: cp, url: t.getAttribute("href") });
      });
    });
  })();
</script>
