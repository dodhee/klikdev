---
// Contact Modal Component
---

<!-- Modal Backdrop -->
<div
  id="contact-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
>
  <!-- Modal Content -->
  <div
    class="bg-background border-border relative m-4 w-full max-w-lg rounded-lg border shadow-xl"
    role="document"
  >
    <!-- Header -->
    <div class="border-border flex items-center justify-between border-b p-4">
      <h2 id="contact-modal-title" class="text-xl font-semibold">
        Hubungi Saya
      </h2>
      <button
        id="close-contact-modal"
        class="hover:bg-muted rounded-lg p-2 transition-colors"
        aria-label="Close contact modal"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="p-6">
      <p class="text-muted-foreground mb-6">
        Ada pertanyaan atau butuh bantuan? Hubungi saya melalui:
      </p>

      <div class="space-y-4">
        <!-- Telegram -->
        <a
          href="https://t.me/klikdev"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:bg-mbah-accent/5 border-border group flex items-start gap-3 rounded-lg border p-4 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-mbah-accent group-hover:scale-110 size-6 shrink-0 transition-transform"
          >
            <path d="m15 10-4 4 6 6 4-16-18 7 4 2 2 6 3-4"></path>
          </svg>
          <div>
            <p class="text-foreground mb-1 font-semibold">Telegram Channel</p>
            <p class="font-signature text-muted-foreground text-sm">
              t.me/klikdev
            </p>
          </div>
        </a>

        <!-- WhatsApp -->
        <a
          href="https://wa.me/6281234796567"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:bg-mbah-accent/5 border-border group flex items-start gap-3 rounded-lg border p-4 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-mbah-accent group-hover:scale-110 size-6 shrink-0 transition-transform"
          >
            <path d="m3 21 1.65-3.8a9 9 0 1 1 3.4 2.9z"></path>
            <path
              d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"
            ></path>
          </svg>
          <div>
            <p class="text-foreground mb-1 font-semibold">WhatsApp</p>
            <p class="font-signature text-muted-foreground text-sm">
              +62 812 3479 6567
            </p>
          </div>
        </a>

        <!-- Email -->
        <div
          class="border-border flex items-start gap-3 rounded-lg border p-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-mbah-accent size-6 shrink-0"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <div>
            <p class="text-foreground mb-1 font-semibold">Email</p>
            <p class="font-signature text-muted-foreground break-all text-sm">
              halo@klikdev.my.id
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initContactModal() {
    const modal = document.getElementById("contact-modal");
    const openButtons = document.querySelectorAll("[data-open-contact-modal]");
    const closeButton = document.getElementById("close-contact-modal");

    if (!modal || !closeButton) return;

    // Open modal
    openButtons.forEach(button => {
      button.addEventListener("click", e => {
        e.preventDefault();
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      });
    });

    // Close modal
    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    };

    closeButton.addEventListener("click", closeModal);

    // Close on backdrop click
    modal.addEventListener("click", e => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  initContactModal();

  document.addEventListener("astro:after-swap", initContactModal);
</script>