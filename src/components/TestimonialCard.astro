---
import type { Testimonial } from "@/data/testimonials/schema";

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;

// Generate avatar fallback (initial dari nama)
const avatarFallback = testimonial.name
  .split(" ")
  .map(word => word[0])
  .join("")
  .toUpperCase()
  .slice(0, 2);

// Format tanggal
const formattedDate = new Intl.DateTimeFormat("id-ID", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(new Date(testimonial.date));
---

<div class="bg-card border-border rounded-lg border p-6">
  <!-- Header: Avatar & Info -->
  <div class="mb-4 flex items-start gap-4">
    <!-- Avatar -->
    <div class="shrink-0">
      {
        testimonial.avatar ? (
          <img
            src={testimonial.avatar}
            alt={testimonial.name}
            class="h-12 w-12 rounded-full object-cover"
            loading="lazy"
          />
        ) : (
          <div class="bg-mbah-accent/10 text-mbah-accent flex h-12 w-12 items-center justify-center rounded-full font-semibold">
            {avatarFallback}
          </div>
        )
      }
    </div>

    <!-- Name & Role -->
    <div class="flex-1">
      <h3 class="text-foreground font-semibold">{testimonial.name}</h3>
      {
        testimonial.role && (
          <p class="text-muted-foreground text-sm">{testimonial.role}</p>
        )
      }
      <p class="text-muted-foreground mt-1 text-xs">{formattedDate}</p>
    </div>

    <!-- Verified Badge -->
    {
      testimonial.verified && (
        <div
          class="bg-green-500/10 text-green-600 dark:text-green-400 rounded-full px-2 py-1 text-xs font-medium"
          title="Verified Purchase"
        >
          ✓ Verified
        </div>
      )
    }
  </div>

  <!-- Rating Stars -->
  <div class="mb-3 flex items-center gap-1">
    {
      Array.from({ length: 5 }, (_, i) => (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill={i < testimonial.rating ? "currentColor" : "none"}
          stroke="currentColor"
          stroke-width="2"
          class:list={[
            "h-5 w-5",
            i < testimonial.rating ? "text-yellow-500" : "text-muted-foreground",
          ]}
        >
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
        </svg>
      ))
    }
    <span class="text-muted-foreground ml-2 text-sm">
      {testimonial.rating}/5
    </span>
  </div>

  <!-- Testimonial Content -->
  <p class="text-foreground leading-relaxed">{testimonial.content}</p>
</div>